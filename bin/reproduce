#!/usr/bin/env sh
# Build twice, from scratch, in two different directories, and compare.
#
# Same machine, same toolchain, same sources: the binaries should be identical.
# Run it before a release: identical binaries mean the build is
# reproducible here.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/omashow-reproduce.XXXXXXXX")"
trap 'rm -rf "$WORK"' EXIT

if command -v qmake6 >/dev/null 2>&1; then QMAKE=qmake6; else QMAKE=qmake; fi
JOBS="$(nproc 2>/dev/null || echo 1)"

for pass in one two; do
    mkdir -p "$WORK/$pass"
    (cd "$WORK/$pass" && "$QMAKE" "$ROOT/omashow.pro" >/dev/null && make -j"$JOBS" >/dev/null)
    printf '%s: ' "$pass"
    sha256sum "$WORK/$pass/omashow" | cut -d' ' -f1
done

if cmp -s "$WORK/one/omashow" "$WORK/two/omashow"; then
    echo "Identical."
else
    echo "The two builds differ." >&2
    exit 1
fi
