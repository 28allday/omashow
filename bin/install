#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PKGBUILD_DIR="$ROOT/pkgbuild"

if ! command -v makepkg >/dev/null 2>&1; then
  echo "OmaShow is built with makepkg. Install the build tools first:" >&2
  echo "  sudo pacman -S --needed base-devel git" >&2
  exit 1
fi

# makepkg installs what OmaShow needs before building it, so nothing is
# compiled here: on a new machine the compiler's libraries are not there yet.

# The package needs a spelling dictionary, and pacman would offer every language
# in alphabetical order. Offer British English first instead, and take any other
# hunspell-* package name if that is what the person wants. Nothing is asked if
# a dictionary is already installed.
if ! pacman -T hunspell-dictionary >/dev/null 2>&1; then
  choice="hunspell-en_gb"
  if [ -t 0 ]; then
    echo "OmaShow checks spelling with a Hunspell dictionary. Which one?"
    echo "  hunspell-en_gb  British English (press Enter)"
    echo "  hunspell-en_us  American English"
    echo "  …or any other: pacman -Ss '^hunspell-' lists them"
    printf "Dictionary [hunspell-en_gb]: "
    read -r answer || answer=""
    [ -n "$answer" ] && choice="$answer"
  fi
  sudo pacman -S --needed --asdeps "$choice"
fi

cd "$PKGBUILD_DIR"
makepkg -fsi "$@"

# Linking the agent skill is part of installing OmaShow: the skill is how a
# coding agent knows the command line exists, and one left in /usr/share is one
# nobody uses. The package cannot do it, because pacman runs as root and must
# not write into a home directory; this script runs as the person, so it does.
if command -v omashow >/dev/null 2>&1; then
  echo
  if omashow skill --link; then
    echo "Your coding agents will find OmaShow's skill in a new session."
  else
    echo "OmaShow is installed, but its skill was not linked." >&2
    echo "Put it in place with: omashow skill --link" >&2
  fi
fi
