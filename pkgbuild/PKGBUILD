# Maintainer: Gavin Nugent

pkgname=omashow
pkgver=0.1.0
pkgrel=1
pkgdesc='Keyboard-first presentation editor and presenter for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/28allday/omashow'
license=('GPL-3.0-or-later')
install='omashow.install'
options=('!debug')
depends=('hicolor-icon-theme' 'qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-multimedia'
         'ffmpeg' 'zlib' 'xdg-desktop-portal' 'hunspell' 'hunspell-dictionary'
         'libetonyek' 'librevenge')
# Spelling needs a dictionary, but which one is the person's choice: every
# hunspell-* language package provides hunspell-dictionary, and pacman asks
# which. ./bin/install offers British English first. More can be added later;
# the deck's language (Document ▸ Language) picks between them.
optdepends=('hunspell-en_gb: British English spelling'
            'hunspell-en_us: American English spelling')
makedepends=('gcc' 'make' 'pkgconf')
source=()
sha256sums=()

# Builds the working tree. ./bin/install uses it, and so does the Oma package
# repository, which versions it from the git history; its depends are the
# release depends.
build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/omashow "$pkgdir/usr/bin/omashow"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 THIRD-PARTY-NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.md"
  /usr/bin/install -Dm644 src/ui/icons/LICENSE.lucide "$pkgdir/usr/share/licenses/$pkgname/LICENSE.lucide"
  /usr/bin/install -Dm644 "$startdir/omashow.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omashow.svg"
  /usr/bin/install -Dm644 "$startdir/omashow.desktop" "$pkgdir/usr/share/applications/omashow.desktop"
  /usr/bin/install -Dm644 "$startdir/omashow.xml" "$pkgdir/usr/share/mime/packages/omashow.xml"
  for example in examples/*.omashow; do
    [ -e "$example" ] || continue
    /usr/bin/install -Dm644 "$example" "$pkgdir/usr/share/omashow/examples/$(basename "$example")"
  done
  # The skill file travels with the app. Installing links it for the person who
  # ran sudo (see omashow.install); the copy here is what those links point at.
  /usr/bin/install -Dm644 skills/omashow/SKILL.md \
    "$pkgdir/usr/share/omashow/skills/omashow/SKILL.md"
}
